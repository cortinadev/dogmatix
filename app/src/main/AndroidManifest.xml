<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- "Configure ES-DE" / "Configure iiSU" read the frontend's bundled defaults from its
         installed APK; without these entries Android 11+ package visibility hides the app and
         the setups wrongly report "not installed". -->
    <queries>
        <package android:name="org.es_de.frontend" />
        <package android:name="com.iisulauncher" />
    </queries>

    <application
        android:name=".DogmatixApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Dogmatix">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Dogmatix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links: dogmatix://library?console=…&region=…&q=…&fav=1 (see util/DeepLinkParser). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dogmatix" android:host="library" />
            </intent-filter>
            <!-- .dgmtx shortcut files (frontends like ES-DE, file managers): the deep link is
                 inside the file (see util/DgmtxFile). The repeated patterns work around
                 PatternMatcher's non-greedy ".*", which stops at the first dot in the path.
                 android:host is required even though any authority is fine: IntentFilter only
                 checks the paths inside its authority branch, so without a host every
                 content:// file of any type matched and Dogmatix was offered to open APKs.
                 The mime types are the ones providers report for an unknown extension; they
                 keep APKs out even when the URI hides the file name. Frontends launch us with
                 an explicit component, so they never go through this filter. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
                <data android:pathPattern=".*\\.dgmtx" />
                <data android:pathPattern=".*\\..*\\.dgmtx" />
                <data android:pathPattern=".*\\..*\\..*\\.dgmtx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.dgmtx" />
            </intent-filter>
        </activity>
        <service
            android:name=".data.service.DownloadForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Persists the language chosen in Settings across launches (AppCompatDelegate.setApplicationLocales). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>
