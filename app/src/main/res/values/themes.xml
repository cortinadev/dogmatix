<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat parent: required by AppCompatActivity, which applies the per-app language on Android 10-12. -->
    <style name="Theme.Dogmatix" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Draw edge to edge, notch included: the gradient reaches the physical edge and the
             content keeps clear of the cutout through WindowInsets.displayCutout (MainActivity). -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
