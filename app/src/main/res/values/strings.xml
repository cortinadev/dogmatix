    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to Dogmatix</string>
    <string name="onboarding_welcome_body">Dogmatix indexes the contents of ROM sources — torrents, magnets and web directories — tags every file by console, region and language, and lets you browse, filter and download straight to your ROMs folder. Archives are extracted automatically.</string>
    <string name="onboarding_welcome_point_1">Sources are indexed, not downloaded: browse thousands of titles without filling your storage.</string>
    <string name="onboarding_welcome_point_2">Filter by console, region, language and type; ✓ marks what you already own.</string>
    <string name="onboarding_welcome_point_3">Downloads land in a folder per console, ready for frontends such as ES-DE.</string>
    <string name="onboarding_folder_title">Where are your ROMs?</string>
    <string name="onboarding_folder_body">Pick the root folder of your ROM library. Each console gets its own sub-folder inside it (existing ones like \"gba\" or \"psx\" are reused). You can change it later in Settings.</string>
    <string name="onboarding_folder_current">Folder: %1$s</string>
    <string name="onboarding_folder_choose">Choose folder</string>
    <string name="onboarding_folder_change">Change folder</string>
    <string name="onboarding_sources_title">Add your sources</string>
    <string name="onboarding_sources_body">Dogmatix ships with no sources. Import a sources JSON (for example the one shared from another device) and every console in it will be indexed right away. You can also add consoles and URLs by hand later in the Sources tab.</string>
